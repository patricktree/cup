{
  "name": "@cup/monorepo-root",
  "private": true,
  "files": [
    "./patches/**",
    "./.pnpmfile.cjs",
    "./.pnpmfile.mjs",
    "./pnpm-lock.yaml",
    "./pnpm-workspace.yaml",
    "./postinstall.sh",
    "./preinstall.sh"
  ],
  "type": "module",
  "scripts": {
    "auth:local": "node tooling/env-setup/src/local-auth.ts",
    "brand-assets:check": "pnpm --filter '@cup/brand-assets' check",
    "brand-assets:sync": "pnpm --filter '@cup/brand-assets' sync",
    "build": "turbo run turbo:build",
    "build:watch": "turbo watch turbo:build",
    "clean": "pnpm run --parallel clean && pnpm exec del-cli \"**/node_modules\" \"**/.turbo\"",
    "declutter": "knip",
    "docs:check": "markdownlint-cli2",
    "docs:search": "node tooling/docs-search/src/cli.ts",
    "env:check": "pnpm --filter env-setup env:check",
    "env:setup": "pnpm --filter env-setup env:setup",
    "fix": "pnpm run format && pnpm run lint:fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "turbo run turbo:lint",
    "lint:fix": "turbo run turbo:lint:fix",
    "operator": "node apps/operator/src/cli.ts",
    "pnpm:devPreinstall": "sh ./preinstall.sh",
    "postinstall": "sh ./postinstall.sh",
    "test": "turbo run turbo:test",
    "test:e2e": "pnpm run test:e2e:app && pnpm run test:e2e:source-material",
    "test:e2e:app": "docker pull mcr.microsoft.com/playwright:v1.63.0-noble && pnpm run build && pnpm --filter '@cup/e2e' test:e2e",
    "test:e2e:source-material": "pnpm --filter '@cup/prepare-source-material' test:e2e",
    "test:e2e:ui": "pnpm run build && pnpm --filter '@cup/e2e' test:e2e:ui",
    "test:e2e:update": "docker pull mcr.microsoft.com/playwright:v1.63.0-noble && pnpm run build && pnpm --filter '@cup/e2e' test:e2e:update",
    "validate": "pnpm run validate:fast && pnpm run validate:extended",
    "validate:evals": "pnpm --filter '@cup/narration-content-selection' eval",
    "validate:extended": "pnpm run declutter && pnpm run brand-assets:check && pnpm run zizmor && pnpm run test:e2e",
    "validate:fast": "pnpm run env:check && pnpm run format:check && pnpm run docs:check && turbo run turbo:build turbo:lint turbo:test",
    "zizmor": "uvx zizmor@1.29.0 --gh-token \"$(gh auth token)\" ."
  },
  "devDependencies": {
    "@cup/config-oxlint": "workspace:*",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@patricktree-stack/config-oxfmt": "workspace:*",
    "cf": "^1.0.0-beta.5",
    "del-cli": "^7.0.0",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "husky": "^9.1.7",
    "knip": "^6.38.0",
    "markdownlint-cli2": "^0.23.3",
    "markdownlint-rule-relative-links": "^5.1.3",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "^2.11.5"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "pnpm": "12.8.1"
  },
  "packageManager": "pnpm@12.8.1"
}
