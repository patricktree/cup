{
  "name": "@cup/brand-assets",
  "private": true,
  "bin": {
    "cup-brand-assets-cli": "./src/cli.ts"
  },
  "files": [
    "src/**",
    "assets/**"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./cup.svg": "./assets/cup.svg"
  },
  "scripts": {
    "build": "turbo run turbo:build",
    "check": "node src/cli.ts check",
    "lint": "turbo run turbo:lint",
    "lint:fix": "turbo run turbo:lint:fix",
    "sync": "node src/cli.ts sync",
    "turbo:build": "prepare-declaration-build --declaration-output-dir ./dist/types --build-info-file ./dist/tsconfig.build.tsbuildinfo --source-package-json ./src/package.json && tsc --build ./tsconfig.json",
    "turbo:lint": "oxlint --type-aware --max-warnings 0 .",
    "turbo:lint:fix": "pnpm run turbo:lint --fix"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "commander": "^15.0.0",
    "sharp": "0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cup/config-oxlint": "workspace:*",
    "@cup/prepare-declaration-build": "workspace:*",
    "@patricktree-stack/config-typescript": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  }
}
