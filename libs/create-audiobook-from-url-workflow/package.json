{
  "name": "@cup/create-audiobook-from-url-workflow",
  "private": true,
  "files": [
    "src/**"
  ],
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/types/workflow.d.ts",
      "default": "./src/workflow.ts"
    },
    "./runner": {
      "types": "./dist/types/run-prepare-audiobook-workflow.d.ts",
      "default": "./src/run-prepare-audiobook-workflow.ts"
    },
    "./segment-runner": {
      "types": "./dist/types/run-audio-segment-workflow.d.ts",
      "default": "./src/run-audio-segment-workflow.ts"
    },
    "./conversion-params": {
      "types": "./dist/types/conversion-params.d.ts",
      "default": "./src/conversion-params.ts"
    }
  },
  "scripts": {
    "build": "turbo run turbo:build",
    "clean": "del-cli --dot=true \"dist\" \"*.tsbuildinfo\"",
    "lint": "turbo run turbo:lint",
    "lint:fix": "turbo run turbo:lint:fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "turbo:build": "prepare-declaration-build --declaration-output-dir ./dist/types --build-info-file ./dist/tsconfig.build.tsbuildinfo --source-package-json ./src/package.json && tsc --build ./tsconfig.json",
    "turbo:lint": "oxlint --type-aware --max-warnings 0 .",
    "turbo:lint:fix": "pnpm run turbo:lint --fix",
    "turbo:test": "pnpm run test"
  },
  "dependencies": {
    "@cloudflare/playwright": "catalog:",
    "@cup/accounts": "workspace:*",
    "@cup/audiobook-production": "workspace:*",
    "@cup/conversion-contracts": "workspace:*",
    "@cup/conversion-grants": "workspace:*",
    "@cup/narration-content-selection": "workspace:*",
    "@cup/narration-document-creation": "workspace:*",
    "@cup/prepare-source-material": "workspace:*",
    "@cup/registry": "workspace:*",
    "temporal-polyfill": "^1.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cup/config-oxlint": "workspace:*",
    "@cup/prepare-declaration-build": "workspace:*",
    "@patricktree-stack/config-typescript": "workspace:*",
    "@patricktree-stack/config-vitest": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
