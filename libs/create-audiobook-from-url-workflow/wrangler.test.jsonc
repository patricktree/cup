{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "workflow-integration-test",
  "main": "test/worker.ts",
  "compatibility_date": "2026-08-18",
  "vars": { "CONVERSION_OWNER_LIMIT": "10" },
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNTS", "class_name": "AccountDurableObject" },
      { "name": "CONVERSION_GRANTS", "class_name": "ConversionGrantDurableObject" },
      { "name": "REGISTRY", "class_name": "RegistryDurableObject" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AccountDurableObject",
        "ConversionGrantDurableObject",
        "RegistryDurableObject",
      ],
    },
  ],
  "workflows": [
    {
      "name": "synthesize-audio-segment-test",
      "binding": "SYNTHESIZE_AUDIO_SEGMENT_WORKFLOW",
      "class_name": "DispatchedAudioSegmentWorkflow",
    },
  ],
  "r2_buckets": [{ "binding": "AUDIO_BUCKET", "bucket_name": "workflow-integration-test" }],
}
