{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "workflow-integration-test",
  "main": "test/worker.ts",
  "compatibility_date": "2026-08-18",
  "durable_objects": {
    "bindings": [
      { "name": "CONVERSION_GRANTS", "class_name": "ConversionGrantDurableObject" },
      { "name": "CONVERSION_GRANT_REGISTRY", "class_name": "ConversionGrantRegistryDurableObject" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ConversionGrantDurableObject",
        "ConversionGrantRegistryDurableObject",
      ],
    },
  ],
  "r2_buckets": [{ "binding": "AUDIO_BUCKET", "bucket_name": "workflow-integration-test" }],
}
