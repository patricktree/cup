{
  "name": "@cup/narration-content-selection",
  "private": true,
  "files": [
    "src/**"
  ],
  "type": "module",
  "imports": {
    "#src/*.ts": {
      "types": "./dist/types/*.d.ts",
      "default": "./src/*.ts"
    },
    "#src/*": {
      "types": "./dist/types/*",
      "default": "./src/*"
    },
    "#test/*.ts": "./test/*.ts",
    "#test/*": "./test/*"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./fake": {
      "types": "./dist/types/narration-content-selection.fake.d.ts",
      "default": "./src/narration-content-selection.fake.ts"
    }
  },
  "scripts": {
    "build": "turbo run turbo:build",
    "clean": "del-cli --dot=true \"dist\" \"generated\" \"*.tsbuildinfo\"",
    "eval": "node --env-file-if-exists=.env.evals ./node_modules/vitest/vitest.mjs run --config=vitest.evals.config.ts --reporter=default --reporter=vitest-evals/reporter --reporter=json --outputFile.json=generated/evals/vitest-results.json",
    "eval:report": "vitest-evals serve generated/evals/vitest-results.json",
    "eval:update": "pnpm run eval --update --testNamePattern='^narration content selection production candidate:'",
    "lint": "turbo run turbo:lint",
    "lint:fix": "turbo run turbo:lint:fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "turbo:build": "tsc --build ./tsconfig.json",
    "turbo:lint": "oxlint --type-aware --max-warnings 0 .",
    "turbo:lint:fix": "pnpm run turbo:lint --fix",
    "turbo:test": "pnpm run test"
  },
  "dependencies": {
    "openai": "^7.25.0",
    "p-map": "^7.0.8",
    "parse5": "^8.0.1",
    "type-fest": "^5.10.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cup/config-oxlint": "workspace:*",
    "@cup/narration-document-creation": "workspace:*",
    "@patricktree-stack/config-typescript": "workspace:*",
    "@patricktree-stack/config-vitest": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tinyrainbow": "^3.1.1",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitest-evals": "0.17.0"
  }
}
