{
  "name": "@cup/api-server",
  "private": true,
  "files": [
    "src/**"
  ],
  "type": "module",
  "imports": {
    "#src/*.ts": {
      "types": "./dist/types/*.d.ts",
      "default": "./src/*.ts"
    },
    "#src/*": {
      "types": "./dist/types/*",
      "default": "./src/*"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    "./web-app-csp": {
      "types": "./dist/types/web-app-csp.d.ts",
      "default": "./src/web-app-csp.ts"
    },
    ".": {
      "types": "./dist/types/api-server.d.ts",
      "default": "./src/api-server.ts"
    }
  },
  "scripts": {
    "build": "turbo run turbo:build",
    "clean": "del-cli --dot=true \"dist\" \"*.tsbuildinfo\"",
    "lint": "turbo run turbo:lint",
    "lint:fix": "turbo run turbo:lint:fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "turbo:build": "tsc --build ./tsconfig.json",
    "turbo:lint": "oxlint --type-aware --max-warnings 0 .",
    "turbo:lint:fix": "pnpm run turbo:lint --fix",
    "turbo:test": "pnpm run test"
  },
  "dependencies": {
    "@cup/audiobook-production": "workspace:*",
    "@cup/conversion-grants": "workspace:*",
    "@cup/create-audiobook-from-url-workflow": "workspace:*",
    "@cup/operator-api.routes": "workspace:*",
    "@cup/web-app-api.routes": "workspace:*",
    "hono": "catalog:hono",
    "jose": "^6.2.12",
    "temporal-polyfill": "^1.0.5"
  },
  "devDependencies": {
    "@cup/config-oxlint": "workspace:*",
    "@patricktree-stack/config-typescript": "workspace:*",
    "@patricktree-stack/config-vitest": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
