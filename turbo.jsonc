{
  "$schema": "./node_modules/turbo/schema.json",
  "noUpdateNotifier": true,
  "concurrency": "100%",
  "agentGuidance": false,
  "globalDependencies": [
    /* Library Worker types are generated from this config, so its runtime changes must invalidate cached tasks. */
    "apps/cloudflare-worker/wrangler.jsonc",
  ],
  "futureFlags": {
    "watchUsingTaskInputs": true,
  },
  /*
   * Library layers, from the bottom up: each library in `libs/` carries one `layer:*` tag, and a
   * library may depend only on libraries in lower layers. Each layer therefore denies its own tag
   * and every tag above it. `tooling/library-layers` checks that every library has a layer tag and
   * that these deny lists stay in this order.
   */
  "boundaries": {
    "tags": {
      "layer:errors": {
        "dependencies": {
          "deny": [
            "layer:errors",
            "layer:foundations",
            "layer:shared-storage-and-production",
            "layer:owners",
            "layer:coordination-and-api-contracts",
            "layer:api-clients-and-conversion-workflow",
            "layer:api-server",
          ],
        },
      },
      "layer:foundations": {
        "dependencies": {
          "deny": [
            "layer:foundations",
            "layer:shared-storage-and-production",
            "layer:owners",
            "layer:coordination-and-api-contracts",
            "layer:api-clients-and-conversion-workflow",
            "layer:api-server",
          ],
        },
      },
      "layer:shared-storage-and-production": {
        "dependencies": {
          "deny": [
            "layer:shared-storage-and-production",
            "layer:owners",
            "layer:coordination-and-api-contracts",
            "layer:api-clients-and-conversion-workflow",
            "layer:api-server",
          ],
        },
      },
      "layer:owners": {
        "dependencies": {
          "deny": [
            "layer:owners",
            "layer:coordination-and-api-contracts",
            "layer:api-clients-and-conversion-workflow",
            "layer:api-server",
          ],
        },
      },
      "layer:coordination-and-api-contracts": {
        "dependencies": {
          "deny": [
            "layer:coordination-and-api-contracts",
            "layer:api-clients-and-conversion-workflow",
            "layer:api-server",
          ],
        },
      },
      "layer:api-clients-and-conversion-workflow": {
        "dependencies": {
          "deny": ["layer:api-clients-and-conversion-workflow", "layer:api-server"],
        },
      },
      "layer:api-server": {
        "dependencies": {
          "deny": ["layer:api-server"],
        },
      },
    },
  },
  "tasks": {
    "turbo:cf-typegen": {
      "cache": true,
      "outputs": ["worker-configuration.d.ts"],
    },
    "turbo:build": {
      "cache": false,
      "inputs": [
        /* default inputs = all git tracked files */
        "$TURBO_DEFAULT$",
        /* exclude markdown files */
        "!*.md",
        /* exclude license files */
        "!LICENSE",
      ],
    },
    "turbo:lint": {
      "cache": false,
      "inputs": [
        /* default inputs = all git tracked files */
        "$TURBO_DEFAULT$",
        /* exclude markdown files */
        "!*.md",
        /* exclude license files */
        "!LICENSE",
      ],
    },
    "turbo:lint:fix": {
      "cache": false,
      "inputs": [
        /* default inputs = all git tracked files */
        "$TURBO_DEFAULT$",
        /* exclude markdown files */
        "!*.md",
        /* exclude license files */
        "!LICENSE",
      ],
    },
    "turbo:test": {
      "cache": false,
      "inputs": [
        /* default inputs = all git tracked files */
        "$TURBO_DEFAULT$",
        /* exclude markdown files */
        "!*.md",
        /* exclude license files */
        "!LICENSE",
      ],
    },
  },
}
