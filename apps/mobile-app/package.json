{
  "name": "@cup/mobile-app",
  "private": true,
  "scripts": {
    "android:device": "node scripts/android-device.mts",
    "build": "turbo run turbo:build && pnpm run native:sync",
    "lint": "turbo run turbo:lint",
    "lint:fix": "turbo run turbo:lint:fix",
    "native:sync": "cap sync android && cap sync ios",
    "turbo:build": "tsc --build",
    "turbo:lint": "oxlint --type-aware --max-warnings 0 .",
    "turbo:lint:fix": "pnpm run turbo:lint --fix"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capawesome/capacitor-google-sign-in": "0.1.4",
    "@cup/web-app": "workspace:*"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@cup/config-oxlint": "workspace:*",
    "@patricktree-stack/config-typescript": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  }
}
