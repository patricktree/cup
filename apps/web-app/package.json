{
  "name": "@cup/web-app",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*.ts": {
      "types": "./dist/types/*.d.ts",
      "default": "./src/*.ts"
    },
    "#src/*.tsx": {
      "types": "./dist/types/*.d.tsx",
      "default": "./src/*.tsx"
    },
    "#src/*": {
      "types": "./dist/types/*",
      "default": "./src/*"
    },
    "#ui-gallery/*.js": "./ui-gallery/*.ts"
  },
  "exports": {
    "./package.json": "./package.json",
    "./vite": "./vite.shared.ts"
  },
  "scripts": {
    "build": "turbo run turbo:build",
    "clean": "del-cli --dot=true \"dist\" \"*.tsbuildinfo\" \"playwright-output\"",
    "dev:gallery": "msw init ui-gallery --save=false && vite --config ui-gallery/vite.config.ts",
    "lint": "turbo run turbo:lint",
    "lint:css": "stylelint \"./src/**/*.(css|ts|cts|mts|tsx|ctsx|mtsx)\"",
    "lint:fix": "turbo run turbo:lint:fix",
    "test:components": "playwright test",
    "test:components:ui": "playwright test --ui",
    "turbo:build": "tsc --build ./tsconfig.json && vite build",
    "turbo:lint": "oxlint --type-aware --max-warnings 0 . && pnpm run lint:css",
    "turbo:lint:fix": "oxlint --type-aware --max-warnings 0 . --fix && pnpm run lint:css --fix",
    "turbo:test": "pnpm run test:components"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@cup/conversion-grants": "workspace:*",
    "@cup/web-app-api.client": "workspace:*",
    "@cup/web-app-api.routes": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@linaria/core": "^8.2.0",
    "@patricktree-stack/utils-ecma": "workspace:*",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "react": "catalog:web-app",
    "react-dom": "catalog:web-app",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cup/config-oxlint": "workspace:*",
    "@patricktree-stack/config-playwright": "workspace:*",
    "@patricktree-stack/config-stylelint": "workspace:*",
    "@patricktree-stack/config-typescript": "workspace:*",
    "@patricktree-stack/config-wyw-in-js": "workspace:*",
    "@playwright/test": "catalog:",
    "@tanstack/router-plugin": "catalog:web-app",
    "@types/node": "catalog:",
    "@types/react": "catalog:web-app",
    "@types/react-dom": "catalog:web-app",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "catalog:web-app",
    "@wyw-in-js/vite": "catalog:web-app",
    "msw": "^2.15.0",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "stylelint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:web-app"
  }
}
