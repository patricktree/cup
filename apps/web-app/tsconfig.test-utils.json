{
  "extends": [
    "@patricktree-stack/config-typescript/tsconfig.defaults.json",
    "@patricktree-stack/config-typescript/tsconfig.web.json",
    "@patricktree-stack/config-typescript/tsconfig.composite-emit-declaration-only.json",
    "@patricktree-stack/config-typescript/tsconfig.typescript-execution-via-type-stripping.json"
  ],
  "compilerOptions": {
    /* Modules */
    "rootDir": "./src/test-utils",
    "types": ["node"],

    /* Emit */
    /* Apart from dist/types, which the declaration build of tsconfig.build.json clears and fills. */
    "outDir": "./dist/test-utils/types"
  },
  "include": ["src/test-utils/**/*"]
}
