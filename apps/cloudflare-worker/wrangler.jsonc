{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "create-audiobook-from-url",
  "main": "src/index.ts",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2026-08-18",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "www.cup-audio.com",
      "custom_domain": true,
    },
    {
      "pattern": "cup-audio.com",
      "custom_domain": true,
    },
    {
      "pattern": "create-audiobook-from-url.patricktree.me",
      "custom_domain": true,
    },
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "none",
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  "limits": {
    "cpu_ms": 300000,
  },
  "upload_source_maps": true,
  "browser": {
    "binding": "BROWSER",
  },
  "workflows": [
    {
      "name": "prepare-audiobook",
      "binding": "PREPARE_AUDIOBOOK_WORKFLOW",
      "class_name": "PrepareAudiobookWorkflow",
    },
    {
      "name": "synthesize-audio-segment",
      "binding": "SYNTHESIZE_AUDIO_SEGMENT_WORKFLOW",
      "class_name": "SynthesizeAudioSegmentWorkflow",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNTS", "class_name": "AccountDurableObject" },
      {
        "name": "CONVERSION_GRANTS",
        "class_name": "ConversionGrantDurableObject",
      },
      {
        "name": "REGISTRY",
        "class_name": "RegistryDurableObject",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ConversionGrantDurableObject",
        "ConversionGrantRegistryDurableObject",
      ],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["AccountDurableObject"],
    },
    {
      "tag": "v3",
      "renamed_classes": [
        { "from": "ConversionGrantRegistryDurableObject", "to": "RegistryDurableObject" },
      ],
    },
  ],
  "ai": {
    "binding": "AI",
  },
  "vars": {
    "LOCAL_DEVELOPMENT": "false",
    "SIGNUP_IP_LIMIT": "10",
    "CONVERSION_IP_LIMIT": "60",
    "CONVERSION_OWNER_LIMIT": "10",
    "SUPABASE_URL": "https://evwjipxgacwotgbmqtla.supabase.co",
    "CLOUDFLARE_ACCOUNT_ID": "a7648178b6a63bb8a13f0c9de89d253f",
    "OPERATOR_ACCESS_ISSUER": "https://patricktree.cloudflareaccess.com",
    "OPERATOR_ACCESS_AUDIENCE": "eb0bf97161ed0be7fdbaa018493cc84d3b25332315cfa8fec3569570035e3461",
    "OPERATOR_EMAIL": "patrick.kerschbaum@gmail.com",
  },
  "r2_buckets": [
    {
      "binding": "AUDIO_BUCKET",
      "bucket_name": "create-audiobook-from-url-audio",
    },
  ],
  "secrets": {
    "required": [
      "CLOUDFLARE_API_KEY",
      "SOURCE_PAGE_COOKIES_JSON",
      "SUPABASE_SECRET_KEY",
      "SUPABASE_PUBLISHABLE_KEY",
      "GOOGLE_WEB_CLIENT_ID",
      "RESEND_API_KEY",
    ],
  },
}
