{
  "name": "@cup/e2e",
  "private": true,
  "type": "module",
  "imports": {
    "#test-vitest/*.ts": "./test-vitest/*.ts",
    "#test-vitest/*": "./test-vitest/*",
    "#test-e2e/*.ts": "./test-e2e/*.ts",
    "#test-e2e/*": "./test-e2e/*"
  },
  "scripts": {
    "clean": "del-cli --dot=true \"*.tsbuildinfo\" \"playwright-output\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --update-snapshots",
    "turbo:build": "tsc --build ./tsconfig.json",
    "turbo:e2e": "pnpm run test:e2e",
    "turbo:e2e:toolchain": "toolchain-key playwright --output .toolchain/playwright.json",
    "turbo:lint": "oxlint --type-aware --max-warnings 0 .",
    "turbo:lint:fix": "pnpm run turbo:lint --fix",
    "turbo:test": "vitest run"
  },
  "dependencies": {
    "@cup/audiobook-production": "workspace:*",
    "@cup/conversion-contracts": "workspace:*",
    "@cup/listener-api.routes": "workspace:*",
    "@cup/test-worker": "workspace:*"
  },
  "devDependencies": {
    "@cup/config-oxlint": "workspace:*",
    "@cup/loading-state-recorder": "workspace:*",
    "@cup/toolchain-key": "workspace:*",
    "@patricktree-stack/config-playwright": "workspace:*",
    "@patricktree-stack/config-typescript": "workspace:*",
    "@patricktree-stack/config-vitest": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
